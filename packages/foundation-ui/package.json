{
  "name": "@rbx/foundation-ui",
  "version": "0.124.0",
  "description": "Roblox FoundationWeb UI Framework",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "require": "./dist/cjs/index.js",
      "import": "./dist/esm/index.js"
    },
    "./style": {
      "types": "./dist/types/style.d.ts",
      "default": "./dist/style.css"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "pnpm build:types && NODE_ENV=production pnpm build:js",
    "build:dev": "pnpm build:types && pnpm build:js",
    "build:js": "rollup -c rollup.config.js",
    "build:types": "tsc -p tsconfig.build.json --emitDeclarationOnly --outDir dist/types",
    "build:clean": "rm -rf dist",
    "lint": "oxlint src/",
    "test": "jest"
  },
  "peerDependencies": {
    "@rbx/foundation-tailwind": "workspace:*",
    "tailwindcss": "^3",
    "react": "^19.0.0"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-roving-focus": "^1.1.19",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@radix-ui/react-visually-hidden": "^1.2.11",
    "clsx": "^2.1.1",
    "usehooks-ts": "^3.1.1"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": false
    },
    "@rbx/foundation-tailwind": {
      "optional": false
    }
  },
  "author": "@roblox/creator-resources-foundation",
  "license": "UNLICENSED",
  "private": false,
  "devDependencies": {
    "@types/react": "^19.0.0",
    "rollup-plugin-css-only": "^4.5.5",
    "rollup-plugin-styles": "^4.0.0"
  }
}